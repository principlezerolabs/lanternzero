# Copy to .env and edit (relay/README.md, "Set up").

# The relay's public name. Its DNS A/AAAA records must point at this
# machine, and ports 80 and 443 must be open, so Caddy can get a
# certificate.
LZ_RELAY_DOMAIN=relay.example.org

# The relay image. Until a release publishes it, compose.yaml builds it
# from this checkout as lantern-zero/relay:local. Once one does, the
# release's digest becomes the default, and this line is only for
# building it yourself (relay/README.md, "The image").
#LZ_RELAY_IMAGE=lantern-zero/relay:local
