# Copy to .env and edit (relay/README.md, "Set up").

# The relay's public name. Its DNS A/AAAA records must point at this
# machine, and ports 80 and 443 must be open, so Caddy can get a
# certificate.
LZ_RELAY_DOMAIN=relay.example.org

# compose.yaml pulls the latest release's signed relay image, pinned by
# digest. To build it from this checkout instead, set a local tag and run
# `docker compose build relay` (relay/README.md, "The image"):
#LZ_RELAY_IMAGE=lantern-zero/relay:local
