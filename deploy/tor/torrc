# Tor for the Lantern Zero onion service (spec §3.1). No relaying, and no
# SOCKS port here; compose.yaml opens one to the kit's network only, for
# `doctor`'s onion check. compose.yaml also passes the service itself on
# the command line (`--HiddenServiceDir /var/lib/tor/lz
# --HiddenServicePort ...`), because Tor needs an IP address for the port,
# which comes from .env, and the two lines must stay together in order.
SocksPort 0
DataDirectory /var/lib/tor
Log notice stdout
