# Copy to .env and edit. This file holds options only, never secrets:
# keys and account tokens live in the lz-data volume.

# Leave empty for byo-node (server and Tor, your own node), or set to
# `full` to run Zebra and Zaino here too (about 500 GB free, days to sync).
COMPOSE_PROFILES=

# main, test, or regtest. Must match the chain source.
LZ_NETWORK=main

# The chain source's gRPC URL (Zaino or lightwalletd). The default below
# is for `full`; for byo-node, change it.
#   full:                          http://zaino:8137
#   byo-node, node on this host:   http://host.docker.internal:8137
#     (on Linux the node must listen on the Docker bridge, not only 127.0.0.1)
#   byo-node, elsewhere:           https://... (plain http:// only on a private network)
LZ_LIGHTWALLETD=http://zaino:8137

# A contact that push gateways may use to reach you (RFC 8292): a mailto:
# or https: URL.
LZ_VAPID_CONTACT=

# Published images, pinned by digest (README.md, "Published images").
# Leave unset to build the images here.
#LZ_SERVER_IMAGE=ghcr.io/principlezerolabs/lantern-zero-server@sha256:...
#LZ_TOR_IMAGE=ghcr.io/principlezerolabs/lantern-zero-tor@sha256:...

# The `full` profile's Zaino. Zaino's 0.10.x image stops at NU7; for the
# fallback built from zaino/ (README.md, "Zaino and NU7"):
#LZ_ZAINO_IMAGE=lantern-zero/zainod:nu7
#LZ_ZAINO_PLATFORM=linux/arm64   # this host's platform; the default is linux/amd64

# Memory limit for the server, which is also its swap limit (spec §6.2).
LZ_SERVER_MEMORY=1g

# The kit's network. Change both if 172.30.77.0/24 collides with yours.
LZ_SUBNET=172.30.77.0/24
LZ_SERVER_IP=172.30.77.10
